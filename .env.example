# LinkedIn Credentials
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Email / SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_app_password
SENDER_NAME=Your Name
SENDER_TITLE=Business Development Manager
AGENCY_NAME=Your Recruitment Agency

# Google Calendar API
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary

# Monitoring Settings
MONITOR_INTERVAL_MINUTES=30
MAX_FOLLOWUPS=3
FOLLOWUP_INTERVAL_DAYS=3

# Search Keywords (comma-separated)
LINKEDIN_SEARCH_KEYWORDS=hiring,recruiting,looking for,open position,job opening
LINKEDIN_TARGET_INDUSTRIES=technology,finance,healthcare,manufacturing

# Database
DATABASE_URL=sqlite:///vicky.db
